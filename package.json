{
  "name": "miras",
  "productName": "Miras",
  "version": "1.0.0",
  "description": "Miras — offline archive of manuscripts and books",
  "main": "electron/main.js",
  "scripts": {
    "pc": "electron .",
    "pc:build": "electron-builder --win portable --x64",
    "apk:init": "npx cap add android && node android-patch/patch.js",
    "apk:sync": "npx cap sync android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor-community/privacy-screen": "^8.0.0",
    "capacitor-native-biometric": "^4.2.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.miras.archive",
    "productName": "Miras",
    "directories": { "output": "dist" },
    "files": ["electron/**", "www/**", "package.json"],
    "win": { "target": ["portable"], "icon": "www/icon-512.png", "signAndEditExecutable": false },
    "portable": { "artifactName": "Miras.exe" }
  }
}
